// OrbitStreet — fuente única de verdad del modelo de datos (NASA Space Apps 2026)
// Esquema orientado a series de tiempo con índices adecuados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estación IoT de ciencia ciudadana (capa ESP32, Fase 2).
model Station {
  id        String        @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  altitude  Float?
  status    StationStatus @default(PENDING)
  /// Identificador autogenerado por el nodo (hash de MAC), único.
  deviceId  String?       @unique
  /// SHA-256 del token de ingesta: en claro SOLO se muestra una vez al registrar.
  tokenHash String?       @unique
  /// Sensor declarado: bme280 | dht11 | dht22 | b3950 | none.
  sensorType String?
  /// Propietario opcional (quien registró la estación desde la web).
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  /// Última telemetría aceptada: para marcar ONLINE/OFFLINE.
  lastSeenAt DateTime?
  createdAt DateTime      @default(now())

  telemetry TelemetryRecord[]

  @@index([latitude, longitude])
}

enum StationStatus {
  PENDING
  ONLINE
  OFFLINE
}

/// Telemetría de estaciones en tierra (series de tiempo).
model TelemetryRecord {
  id          String   @id @default(cuid())
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId   String
  timestamp   DateTime
  temperature Float?
  humidity    Float?
  pressure    Float?
  /// Sesgo respecto a la línea base NASA (normal mes×hora) en °C.
  nasaBias    Float?
  quality     Quality  @default(UNVALIDATED)

  /// Índice compuesto obligatorio para consultas por estación y tiempo.
  @@index([stationId, timestamp])
}

enum Quality {
  UNVALIDATED
  VALIDATED
  SUSPICIOUS
}

/// Investigación guardada del Modo Detective (parámetros + resultados deterministas).
model Investigation {
  id          String   @id @default(cuid())
  locale      String
  variable    String
  latitude    Float
  longitude   Float
  periodStart DateTime
  periodEnd   DateTime
  /// Parámetros de la consulta (estación del año, desestacionalización, etc.).
  paramsJson  Json
  /// Resultados deterministas calculados en código: Mann-Kendall, Sen, IC, FDR.
  resultJson  Json
  /// Conclusión redactada por IA (solo texto; la IA nunca calcula cifras).
  aiConclusion String?
  createdAt   DateTime @default(now())

  @@index([variable, createdAt])
}

/// Caché de series NASA POWER (evita llamar a la API en cada análisis).
model PowerCache {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  parameter String
  temporal  String   // "daily" | "hourly"
  start     DateTime
  end       DateTime
  dataJson  Json
  fetchedAt DateTime @default(now())

  @@unique([latitude, longitude, parameter, temporal, start, end])
}

/// Usuario registrado: necesario para subir datos comunitarios y guardar progreso.
/// El análisis público sigue abierto para todos; solo la subida exige cuenta.
/// Identidad simple: usuario + contraseña (sin correo obligatorio). El email
/// queda opcional como identificador heredado de cuentas previas.
model User {
  id        String   @id @default(cuid())
  /// Nombre de usuario (minúsculas): único. Registro simple sin correo.
  username  String?  @unique
  /// Email opcional (cuentas heredadas pueden iniciar sesión con él).
  email     String?  @unique
  /// Hash scrypt con sal aleatoria (formato: scrypt$salt$hash). NUNCA en claro.
  passwordHash String
  /// Por defecto coincide con el username; editable más adelante.
  displayName String
  locale    String   @default("es")
  /// Cooldown de subidas, en minutos, flexible por cuenta (default 10).
  uploadCooldownMinutes Int @default(10)
  createdAt DateTime @default(now())

  sessions        Session[]
  communitySeries CommunitySeries[]
  observations    Observation[]
  cases           Case[]
  stations        Station[]
  caseConfirmations CaseConfirmation[]

  @@index([email])
}

/// Sesión: la cookie httpOnly lleva el token aleatorio; en la DB solo se
/// guarda su hash SHA-256 (robo de DB ≠ robo de sesiones).
model Session {
  /// Hash SHA-256 del token de sesión.
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

/// Series comunitarias subidas por usuarios ("sube tu serie"), con su análisis.
model CommunitySeries {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  label        String
  variable     String
  latitude     Float?
  longitude    Float?
  unit         String
  /// Datos originales: [{ date, value }]
  dataJson     Json
  /// Análisis determinista (MK/Sen/IC) generado por el mismo motor estadístico.
  analysisJson Json?
  createdAt    DateTime @default(now())

  /// Índice para la consulta de cooldown (última subida del usuario).
  @@index([userId, createdAt])
}

/// Cómo se obtuvo la ubicación declarada de una observación.
/// La IP NUNCA es fuente de verdad (la derriba una VPN); solo se usa como
/// señal auxiliar de inconsistencia en el cliente.
enum LocationSource {
  /// GPS embebido en el EXIF de la foto (confirmado por el usuario).
  EXIF
  /// Geolocation API del navegador (con permiso explícito).
  GPS
  /// Punto seleccionado en el globo del mapa.
  MAP
}

/// Cómo ingresó el dato el usuario.
enum InputMode {
  /// Lectura extraída de una imagen por IA de visión (el usuario confirmó).
  PHOTO
  /// Valor escrito a mano por el usuario.
  MANUAL
}

/// Observación puntual comunitaria con evidencia (foto o manual).
/// Un punto NO es una serie: se acumulan por usuario+variable+celda y, al
/// llegar al umbral (p. ej. 10), habilitan el análisis determinista propio.
/// NUNCA se mezcla con datos NASA sin su etiqueta de procedencia.
model Observation {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  variable       String
  value          Float
  unit           String
  /// Fecha (día) que representa la lectura.
  observedAt     DateTime
  latitude       Float
  longitude      Float
  locationSource LocationSource
  inputMode      InputMode
  /// Extracción por IA de visión: { engine, confidence, description }.
  /// null cuando inputMode = MANUAL.
  extractionJson Json?
  /// Cross-check determinista contra la celda MERRA-2 de ese día:
  /// { cellValue, bias, verdict } — veredicto calculado en código, no por IA.
  nasaCheckJson  Json?
  createdAt      DateTime       @default(now())

  /// Cooldown del usuario y futuras consultas por celda/variable.
  @@index([userId, createdAt])
  @@index([latitude, longitude, variable])
}

/// Caso del detective publicado por un usuario ("Tablón de Casos").
/// El usuario aporta la hipótesis local y la nota de campo (el contexto
/// humano que el satélite no ve); el análisis determinista se RECALCULA
/// en el servidor al publicar (nunca se confía en números del navegador)
/// y la IA solo redacta la conclusión con las cifras ya calculadas.
model Case {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// Sospecha o relato local que motivó la investigación (10-200).
  hypothesis  String
  /// Contexto humano de la calle: lo que el satélite no ve (20-1000).
  fieldNote   String
  placeName   String
  locale      String   @default("es")
  latitude    Float
  longitude   Float
  variable    String
  season      String
  /// Años del periodo investigado (YYYY).
  periodStart String
  periodEnd   String
  /// Análisis determinista recalculado server-side: { trend, sigma, yearsNeeded }.
  resultJson  Json
  /// Desnormalizados para filtros y tarjetas (calculados en código).
  significant Boolean
  slopePerDecade Float
  /// Conclusión redactada por IA (solo texto; plantilla determinista sin clave).
  aiConclusion String?
  createdAt   DateTime @default(now())

  confirmations CaseConfirmation[]

  @@index([createdAt])
  @@index([significant, createdAt])
  @@index([latitude, longitude])
}

/// "Yo lo observo": confirmación ciudadana, una por usuario y caso.
model CaseConfirmation {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([caseId, userId])
}
