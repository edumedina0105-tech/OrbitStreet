# OrbitStreet - Variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA commitear .env.

# Base de datos PostgreSQL (Railway provee DATABASE_URL; local: docker o instalacion propia)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbitstreet"

# Gemini API: SOLO redacta el informe del detective con numeros ya calculados.
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Modelo de Gemini (opcional; el default es gemini-3.8-flash).
# Si la API responde 404 "no longer available to new users", cambia aqui el modelo.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Entorno: development | production
NODE_ENV="development"
